# Copy to `.env` and fill in. Nothing else in this project needs a key -
# yfinance is open, and breadth is counted from prices rather than bought.
#
# Free key, no card: https://www.alphavantage.co/support/#api-key
# The free tier allows 25 requests a day, which is why alpha.py gathers the
# put-call history a few days at a time instead of all at once.
ALPHAVANTAGE_API_KEY=
